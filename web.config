<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config for IIS.
  Tells IIS to show our own /404.html whenever a page isn't found,
  instead of IIS's built-in "HTTP Error 404.0 - Not Found" page.
  Must sit in the SAME folder as index.html (the site root).
-->
<configuration>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
